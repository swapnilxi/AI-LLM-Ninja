# Copy to .env. Every value here can ALSO be changed from the UI (Settings tab);
# UI changes are saved to data/settings.json and take precedence over this file.
# Leave a value empty to use the built-in default.

# ---- LLM: gemini | ollama | deepseek | openrouter | groq | openai ---------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=                     # empty = provider default (ollama: llama3.2, gemini: gemini-flash-latest)
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=0               # 0 = provider default

OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=                # https://aistudio.google.com/apikey (free tier)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=            # https://openrouter.ai/keys (models ending in :free cost nothing)
GROQ_API_KEY=                  # https://console.groq.com/keys (free tier)
OPENAI_API_KEY=                # https://platform.openai.com/api-keys
# Optional base-URL overrides (any OpenAI-compatible server works via OPENAI_BASE_URL):
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Embeddings: sentence-transformers | ollama | gemini | openai | hash -------------------
# sentence-transformers needs:  pip install -e ".[local]"
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=               # empty = provider default
EMBEDDING_DIMENSIONS=0         # gemini / openai only; 0 = gemini 768, openai native (1536)

# ---- Vector store: chroma | postgres -----------------------------------------------
VECTOR_STORE=chroma
CHROMA_PATH=data/chroma
# Local Postgres (docker compose up -d) or Neon. Neon: copy the connection string, keep ?sslmode=require
DATABASE_URL=
VECTOR_TABLE=rag_chunks

# ---- RAG behaviour ---------------------------------------------------------------------
RAG_DATA_DIR=../rag-data       # each folder inside is one profile (rag-data/company1/, rag-data/common/ ...)
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SCORE_THRESHOLD=0.0            # 0..1 minimum cosine similarity
HISTORY_TURNS=4
QUERY_REWRITE=false
AUTO_SYNC_INTERVAL=0           # seconds between automatic syncs; 0 = manual

# ---- Deployment / security (environment only; NOT editable from the UI) ---------------
ALLOW_UI_CONFIG=true           # production: false locks Settings to this file
ALLOW_UI_UPLOAD=true
ADMIN_TOKEN=                   # if set, every /api call needs "Authorization: Bearer <token>"
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=25
SYNC_ON_STARTUP=true
