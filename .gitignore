# =============================================================================
# Secrets and environment files. Never commit real keys; commit a .env.example.
# NOTE: ignoring a file does NOT untrack it. Anything already committed stays
# tracked until you run `git rm --cached <path>`.
# =============================================================================
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/.secret_key
*.pem

# =============================================================================
# Python
# =============================================================================
# Ignore all .venv directories
**/.venv/
Amazon-AI-scrap-research/Amazon-Python-Scraper/.venv
venv/
**/venv/

# Ignore Python cache directories
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/
.coverage
htmlcov/

# =============================================================================
# Node / frontend
# =============================================================================
# Ignore all node_modules directories
**/node_modules/

# Build output and caches (regenerated by `npm run build` / dev servers)
dist/
build/
.next/
.vite/
.turbo/
.parcel-cache/
.cache/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Logs and local databases (runtime state, not source)
# =============================================================================
*.log
logs/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal

# =============================================================================
# Editors and OS files
# =============================================================================
# Ignore macOS system files
.DS_Store
._*

# Ignore other common system files
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor folders: keep the shared settings, ignore the rest
.idea/
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/launch.json
!**/.vscode/tasks.json
!**/.vscode/extensions.json
*.swp
*.swo
*~

# =============================================================================
# AI tooling: local, per-machine state (the project skills in .agents/ ARE committed)
# =============================================================================
.claude/settings.local.json
.claude/worktrees/

# =============================================================================
# Project specific files
# =============================================================================
/Vision-RAG/visionrag-backend/Room_Dataset/HomeObjects-dataset
# Ignore SUNRGBD dataset
Vision-RAG/visionrag-backend/room_dataset/SUNRGBD/
