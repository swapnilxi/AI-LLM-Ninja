# ---------------------------------------------------------------- core
ENV=development                      # production enables strict checks and hides /docs
# SECRET_KEY: REQUIRED in production (>= 32 chars). Encrypts stored secrets and signs tokens.
# ./startup.sh prod fills it in automatically (reusing the dev key if you have one).
SECRET_KEY=
DATABASE_URL=sqlite+aiosqlite:///./data/agentforge.db
# DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge   (pip install asyncpg)
PUBLIC_BASE_URL=http://localhost:8000  # used to build webhook URLs

# ---------------------------------------------------------------- security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=                       # e.g. agents.example.com (empty = allow all)
TRUST_PROXY_HEADERS=false            # true only behind a trusted reverse proxy (X-Forwarded-For)
REGISTRATION_OPEN=true               # false = only the first user can self-register; others are invited
ACCESS_TOKEN_MINUTES=720
ALLOW_PRIVATE_NETWORK=false          # SSRF guard: never let tools reach internal addresses
MAX_REQUEST_MB=2
MAX_UPLOAD_MB=15
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------- rate limits (per minute)
REDIS_URL=                           # optional: share limits across instances (redis://localhost:6379/0)
RATE_LIMIT_GLOBAL_PER_MINUTE=600     # per client IP
RATE_LIMIT_AUTH_PER_MINUTE=10        # login/register per IP and per email
RATE_LIMIT_RUNS_PER_MINUTE=30        # run starts per org
RATE_LIMIT_WEBHOOK_PER_MINUTE=60     # per webhook token

# ---------------------------------------------------------------- run guardrails
MAX_CONCURRENT_RUNS_PER_ORG=8
DEFAULT_DAILY_TOKEN_LIMIT=2000000    # per org per UTC day, 0 = unlimited (orgs can override)
RUN_TIMEOUT_SECONDS=900
TOOL_TIMEOUT_SECONDS=60
MAX_AGENT_DEPTH=3

# ---------------------------------------------------------------- models (server-wide fallback; orgs can set their own keys in the UI)
DEFAULT_PROVIDER=                    # empty = auto-detect from keys, else mock (offline)
DEFAULT_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------- web search (optional; DuckDuckGo is used without keys)
TAVILY_API_KEY=
BRAVE_API_KEY=

SCHEDULER_ENABLED=true
